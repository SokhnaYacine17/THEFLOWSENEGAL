  <style>
    /* Styles spÃ©cifiques Ã  la page Programme */
    .programme-header {
      background: linear-gradient(135deg, #0D2B28 0%, #1A4A42 100%);
      padding: 160px 0 80px;
      text-align: center;
      color: white;
      position: relative;
      overflow: hidden;
    }

    .programme-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url('https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?w=1920&h=600&fit=crop') center/cover no-repeat;
      opacity: 0.25;
      mix-blend-mode: overlay;
    }

    .programme-header h1 {
      font-size: 3.5rem;
      font-weight: 800;
      margin-bottom: 1rem;
      position: relative;
      z-index: 2;
    }

    .programme-header .highlight {
      color: var(--accent);
    }

    .programme-header p {
      font-size: 1.2rem;
      max-width: 700px;
      margin: 0 auto;
      opacity: 0.9;
      position: relative;
      z-index: 2;
    }

    /* Introduction */
    .intro-section {
      padding: 80px 0;
      background: var(--light);
    }

    .intro-text {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .intro-text p {
      color: var(--gray);
      line-height: 1.8;
      margin-bottom: 1.5rem;
      font-size: 1.05rem;
    }

    .intro-quote {
      font-size: 1.3rem;
      font-style: italic;
      color: var(--primary);
      margin-top: 30px;
    }

    /* Timeline des Ã©vÃ©nements */
    .timeline-section {
      padding: 80px 0;
      background: var(--white);
    }

    .timeline-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .timeline-day {
      background: var(--light);
      border-radius: 24px;
      padding: 40px;
      box-shadow: var(--shadow);
      transition: var(--transition);
    }

    .timeline-day:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .day-title {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .day-subtitle {
      color: var(--secondary);
      font-weight: 600;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 2px solid rgba(0,0,0,0.05);
