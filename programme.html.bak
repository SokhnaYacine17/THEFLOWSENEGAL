    }

    .project-card h3 {
      font-size: 1.3rem;
      margin-bottom: 15px;
    }

    .project-card p {
      color: var(--gray);
      line-height: 1.6;
    }

    .citation-section {
      padding: 80px 0;
      background: var(--white);
    }

    .citation-card {
