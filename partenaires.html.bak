  <link rel="stylesheet" href="CSS/style.css">

  <style>
    /* Styles spÃ©cifiques Ã  la page Partenaires */
    .partners-header {
      background: linear-gradient(135deg, #0D2B28 0%, #1A4A42 100%);
      padding: 160px 0 80px;
      text-align: center;
      color: white;
      position: relative;
      overflow: hidden;
    }

    .partners-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url('https://images.unsplash.com/photo-1523805009345-7448845a9e53?w=1920&h=600&fit=crop') center/cover no-repeat;
      opacity: 0.25;
      mix-blend-mode: overlay;
    }

    .partners-header h1 {
      font-size: 3.5rem;
      font-weight: 800;
      margin-bottom: 1rem;
      position: relative;
      z-index: 2;
    }

    .partners-header .highlight {
      color: var(--accent);
    }

    .partners-header p {
      font-size: 1.2rem;
      max-width: 700px;
      margin: 0 auto;
      opacity: 0.9;
      position: relative;
      z-index: 2;
    }

    /* CatÃ©gories de partenaires */
    .category-section {
      padding: 80px 0;
    }

    .category-section:nth-child(even) {
      background: var(--light);
    }

    .category-section:nth-child(odd) {
      background: var(--white);
    }

    .category-title {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .category-icon {
      width: 50px;
      height: 50px;
      background: rgba(13, 92, 99, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .category-icon i {
      font-size: 1.5rem;
      color: var(--primary);
    }

    .category-desc {
      color: var(--gray);
      margin-bottom: 40px;
      padding-left: 65px;
    }

    /* Grille des partenaires */
    .partners-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
    }

    .partner-card {
      background: white;
      border-radius: 20px;
      padding: 30px;
      text-align: center;
      transition: var(--transition);
      box-shadow: var(--shadow);
      border: 1px solid rgba(0,0,0,0.05);
    }

    .partner-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .partner-logo {
      width: 100px;
      height: 100px;
      background: rgba(13, 92, 99, 0.05);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }

    .partner-logo i {
      font-size: 3rem;
      color: var(--primary);
    }

    .partner-logo img {
      width: 60px;
      height: auto;
    }

    .partner-card h3 {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .partner-type {
      display: inline-block;
      background: rgba(13, 92, 99, 0.1);
      color: var(--primary);
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-bottom: 15px;
    }

    .partner-description {
      color: var(--gray);
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .partner-link {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: var(--transition);
    }

    .partner-link:hover {
      color: var(--secondary);
      gap: 12px;
    }

    /* Partenaires institutionnels (style diffÃ©rent) */
    .institution-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 30px;
    }

    .institution-card {
      background: white;
      border-radius: 16px;
      padding: 25px;
      text-align: center;
      transition: var(--transition);
      box-shadow: var(--shadow);
    }

    .institution-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .institution-logo {
      width: 80px;
      height: 80px;
      background: rgba(13, 92, 99, 0.05);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 15px;
    }

    .institution-logo i {
      font-size: 2.2rem;
      color: var(--primary);
    }

    .institution-card h4 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 5px;
    }

    .institution-card p {
      color: var(--gray);
      font-size: 0.8rem;
    }

    /* Devenir partenaire */
    .become-partner {
      background: linear-gradient(135deg, #0D2B28 0%, #1A4A42 100%);
      padding: 80px 0;
      text-align: center;
      color: white;
    }

    .become-partner h2 {
      font-size: 2.2rem;
      margin-bottom: 20px;
    }

    .become-partner p {
      max-width: 600px;
      margin: 0 auto 30px;
      opacity: 0.9;
    }

    .btn-partner {
      background: var(--secondary);
      color: var(--dark);
      padding: 14px 36px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: var(--transition);
    }

    .btn-partner:hover {
      background: var(--secondary-dark);
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    @media (max-width: 768px) {
      .partners-header h1 {
        font-size: 2.2rem;
      }
      .category-title {
        font-size: 1.5rem;
        flex-direction: column;
        text-align: center;
      }
      .category-desc {
        padding-left: 0;
        text-align: center;
      }
      .become-partner h2 {
        font-size: 1.6rem;
      }
    }
  </style>
</head>
